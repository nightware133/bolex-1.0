rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Security helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.uid is string &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.uid.size() <= 128 &&
        data.email is string &&
        data.email.size() <= 256 &&
        data.displayName is string &&
        data.displayName.size() <= 100 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
        (!('isBolexPlus' in data) || data.isBolexPlus is bool) &&
        (!('planTier' in data) || (data.planTier is string && (data.planTier == 'free' || data.planTier == 'plus'))) &&
        data.createdAt is string &&
        data.createdAt.size() <= 40 &&
        data.updatedAt is string &&
        data.updatedAt.size() <= 40;
    }

    // Match block for users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'bio', 'createdAt', 'updatedAt', 'isBolexPlus', 'planTier']) &&
        isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'updatedAt', 'email', 'isBolexPlus', 'planTier']);

      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
